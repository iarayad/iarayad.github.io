<%
  // The two most recent papers, dated by publication or, for preprints, by arXiv submission.
  const month = (d) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
  const news = items.map((item) => {
    const published = item.journal && item.vol && item.page && item.doi;
    return {
      date: new Date(published ? item.published : item.on_arxiv),
      label: published ? `Published in ${_.escape(item.journal)}` : 'New preprint',
      text: `<em>${_.escape(item.title)}</em>`,
      href: published ? `https://doi.org/${item.doi}` : `https://arxiv.org/abs/${item.id}`,
    };
  }).sort((a, b) => b.date - a.date).slice(0, 2);
%>
```{=html}
<ul class="news-list">
  <% for (const n of news) { %>
  <li class="news-item">
    <span class="news-date"><%- month(n.date) %> · <%- n.label %></span>
    <a class="news-text" href="<%- n.href %>"><%= n.text %></a>
  </li>
  <% } %>
</ul>
```
